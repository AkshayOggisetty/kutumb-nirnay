# Copy this file to .env.local and paste your real keys there.
# .env.local is gitignored and must never be committed.
#
# Several keys, comma separated, are rotated round robin by api/chat.js.
# If one hits its rate limit the next is tried automatically.
GEMINI_API_KEYS=key_one_here,key_two_here,key_three_here

# Optional: override the model.
# GEMINI_MODEL=gemini-3.1-flash-lite
